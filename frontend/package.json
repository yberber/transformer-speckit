{
  "name": "inside-the-transformer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:unit": "vitest run --project unit",
    "test:contract": "vitest run --project contract",
    "test:e2e": "playwright test",
    "test:e2e:fullstack": "E2E_FULLSTACK=1 playwright test",
    "gen:api-types": "openapi-typescript ../contracts/inference-api.openapi.yaml -o src/generated/api-types.ts",
    "check:api-types": "openapi-typescript ../contracts/inference-api.openapi.yaml -o node_modules/.cache/api-types.check.ts && diff -u src/generated/api-types.ts node_modules/.cache/api-types.check.ts",
    "check:budgets": "node scripts/check-budgets.mjs",
    "lhci": "lhci autorun"
  },
  "dependencies": {
    "svelte": "^5.57.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.4",
    "vitest": "^5.0.4"
  }
}
